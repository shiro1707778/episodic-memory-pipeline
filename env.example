# Copy this file to .env and configure
# cp env.example .env

# Embedding provider configuration
# Options: openai, local, mock
EMBEDDING_PROVIDER=mock

# OpenAI settings (if using openai provider)
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM settings for extraction/summarization
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# For local LLM (e.g., ollama)
LOCAL_LLM_URL=http://localhost:11434/v1

# Database path
DATABASE_PATH=./data/memory.db
FAISS_INDEX_PATH=./data/memory.faiss

# Memory settings
EMBEDDING_DIMENSION=1536
MIN_MEMORY_CONFIDENCE=0.6
CONSOLIDATION_WINDOW_DAYS=7

